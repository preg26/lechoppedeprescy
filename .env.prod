###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET=${APP_SECRET}
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# PostgreSQL en production (version 15.18)
# La variable DATABASE_URL doit être définie dans les variables d'environnement du container
# Format: postgresql://user:password@host:5432/dbname?serverVersion=15&charset=utf8
DATABASE_URL=${DATABASE_URL}
###< doctrine/doctrine-bundle ###
