{% extends 'admin/base.html.twig' %}

{% block page_title %}Modifier l'utilisateur{% endblock %}

{% block content %}
<div class="card">
    <form method="post">
        <div style="margin-bottom: 1.5rem;">
            <label for="email" style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Email *</label>
            <input type="email" id="email" name="email" value="{{ user.email }}" required style="width: 100%; padding: 0.75rem; border: 1px solid #E0E0E0; border-radius: 6px; font-size: 0.95rem;">
        </div>

        <div style="margin-bottom: 1.5rem;">
            <label for="password" style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Nouveau mot de passe</label>
            <input type="password" id="password" name="password" minlength="6" style="width: 100%; padding: 0.75rem; border: 1px solid #E0E0E0; border-radius: 6px; font-size: 0.95rem;">
            <small style="color: #6B6B6B;">Laissez vide pour conserver le mot de passe actuel. Minimum 6 caractères si changement.</small>
        </div>

        <div style="margin-bottom: 1.5rem;">
            <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Rôles *</label>
            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                    <input type="checkbox" name="roles[]" value="ROLE_ADMIN" {{ 'ROLE_ADMIN' in user.roles ? 'checked' : '' }}>
                    <span>Administrateur (accès complet)</span>
                </label>
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                    <input type="checkbox" name="roles[]" value="ROLE_CONTENT_MANAGER" {{ 'ROLE_CONTENT_MANAGER' in user.roles ? 'checked' : '' }}>
                    <span>Gestionnaire de contenu (contenus et créations)</span>
                </label>
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                    <input type="checkbox" name="roles[]" value="ROLE_CONTACT_MANAGER" {{ 'ROLE_CONTACT_MANAGER' in user.roles ? 'checked' : '' }}>
                    <span>Gestionnaire de contacts (demandes uniquement)</span>
                </label>
            </div>
            <small style="color: #6B6B6B; display: block; margin-top: 0.5rem;">Au moins un rôle doit être sélectionné. ROLE_USER est ajouté automatiquement.</small>
        </div>

        <div style="display: flex; gap: 1rem;">
            <button type="submit" class="btn">Enregistrer les modifications</button>
            <a href="{{ path('admin_users') }}" class="btn btn-secondary">Annuler</a>
        </div>
    </form>
</div>
{% endblock %}
